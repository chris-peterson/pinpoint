# Implementation 1: Python

run *args:
    cd {{justfile_directory()}} && uv run python -m pinpoint --config {{justfile_directory()}}/config.yaml {{args}}

dev *args:
    cd {{justfile_directory()}} && uv run python -m pinpoint --config {{justfile_directory()}}/config.yaml --reload {{args}}

test *args:
    cd {{justfile_directory()}} && uv run pytest {{args}}

lint:
    cd {{justfile_directory()}} && uv run ruff check src/

format:
    cd {{justfile_directory()}} && uv run ruff format src/

# Reset database (re-created on next run)
reset:
    rm -rf {{justfile_directory()}}/.data
    @echo "Database reset. Will be re-created on next run."
